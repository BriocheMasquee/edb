    {
      "type": "spacer",
      "height": 8
    },
    {
      "type": "hStack",
      "bgColor": "#AACACD40",
      "padding": [2, 8],
      "views": [
        {
          "style": "bandHeading",
          "width": -1,
          "value": "{{'Character.Skills'|l}}"
        }
      ]
    },
    {
      "style": "columnLabelStart",
      "value": "{{'Character.SkillTagLevel1'|l}}",
      "visibleIf": "{% if data.class.name %}true{% endif %}"
    },
    {
      "type": "disclosureGroup",
      "title": "{{'Class.ResistanceBonus'|l}}",
      "style": "skillTitle",
      "visibleIf": "{% if data.class.resistanceBonusLevel1 %}true{% endif %}",
      "views": [
        {
          "type": "text",
          "value": "{{data.class.resistanceBonusLevel1}}"
        }
      ]
    },
    {
      "type": "list",
      "attribute": "data.class.bonusLevel1",
      "views": [
        {
          "type": "disclosureGroup",
          "title": "{{name}}",
          "style": "skillTitle",
          "views": [
            {
              "type": "text",
              "value": "{{text}}"
            }
          ]
        }
      ]
    },
    {
      "type": "spacer",
      "height": 6,
      "visibleIf": "{% if data.class.name and data.level >= 2 %}true{% endif %}"
    },
    {
      "style": "columnLabelStart",
      "value": "{{'Character.SkillTagLevelUp'|l}}",
      "visibleIf": "{% if data.class.name and data.level >= 2 %}true{% endif %}"
    },
    {
      "type": "disclosureGroup",
      "title": "{{'Class.ResistanceBonus'|l}}",
      "style": "skillTitle",
      "visibleIf": "{% if data.class.resistanceBonusLevelUp and data.level >= 2 %}true{% endif %}",
