{
  "tintColor": "#267890",
  "primaryColor": "#267890",
  "textColor": "#242422",
  "dividerColor": "#AACACD",
  "bgColor": "#f8f8f8",
  "bgImage": "/images/paper.png",
  "checkboxStyles": {
    "default": {
      "tintColor": "#267890",
      "icon": "square"
    },
    "checked": {
      "primaryColor": "#267890",
      "tintColor": "#284858",
      "icon": "square.inset.filled"
    }
  },
  "dividerStyles": {
    "default": {
      "shape": "rectangle",
      "color": "#267890"
    },
    "rectangle": {
      "shape": "rectangle",
      "color": "#267890"
    }
  },
  "tableStyles": {
    "default": {
      "head": {
        "font": "Oswald-SemiBold",
        "color": "#ffffff",
        "bgColor": "#284858",
        "case": "uppercase",
        "size": 14
      },
      "body": {
        "font": "Oswald-Regular",
        "size": 14
      },
      "rowStyle": "odd",
      "rowColor": "#AACACD40"
    }
  },
  "buttonStyles": {
    "default": {
      "color": "#284858",
      "bgColor": "#00000000",
      "cornerRadius": 0,
      "body": {
        "font": "Oswald-SemiBold",
        "color": "#284858",
        "case": "uppercase",
        "size": 12
      }
    },
    "rollButton": {
      "color": "#267890",
      "bgColor": "#00000000",
      "borderColor": "#267890",
      "borderWidth": 1,
      "cornerRadius": 4,
      "body": {
        "font": "Oswald-SemiBold",
        "color": "#267890",
        "case": "uppercase",
        "alignment": "center",
        "size": 10
      }
    },
    "wearButton": {
      "color": "#267890",
      "bgColor": "#00000000",
      "cornerRadius": 0,
      "padding": [0, 0],
      "body": {
        "font": "Oswald-SemiBold",
        "color": "#267890",
        "case": "uppercase",
        "alignment": "center",
        "size": 10
      }
    },
    "prominent": {
      "color": "#ffffff",
      "bgColor": "#284858",
      "cornerRadius": 0,
      "body": {
        "font": "Oswald-SemiBold",
        "color": "#ffffff",
        "case": "uppercase",
        "size": 12
      }
    }
  },
  "textStyles": {
    "body": {
      "font": "Merriweather24pt-Regular",
      "size": 13,
      "lineSpacing": 3.5,
      "paragraphSpacing": 12
    },
    "title": {
      "font": "CoveredByYourGrace",
      "color": "#284858",
      "size": 25
    },
    "bandTitle": {
      "font": "CoveredByYourGrace",
      "color": "#ffffff",
      "size": 25
    },
    "source": {
      "font": "Oswald-Light",
      "color": "#284858",
      "size": 12
    },
    "stats": {
      "font": "Oswald-Regular",
      "size": 14
    },
    "bullet": {
      "font": "Merriweather24pt-Regular",
      "color": "#267890",
      "size": 13
    },
    "hpLabel": {
      "font": "Oswald-SemiBold",
      "color": "#284858",
      "alignment": "center",
      "size": 14
    },
    "hpValue": {
      "font": "Oswald-SemiBold",
      "color": "#267890",
      "alignment": "center",
      "size": 16
    },
    "columnLabel": {
      "font": "Merriweather24pt-Italic",
      "color": "#6b7b83",
      "alignment": "center",
      "size": 11
    },
    "columnLabelEnd": {
      "font": "Merriweather24pt-Italic",
      "color": "#6b7b83",
      "alignment": "trailing",
      "size": 11
    },
    "headerInfo": {
      "font": "Merriweather24pt-Italic",
      "size": 11
    },
    "headerWarn": {
      "font": "Merriweather24pt-Italic",
      "color": "#B3261E",
      "size": 11
    },
    "columnLabelStart": {
      "font": "Merriweather24pt-Italic",
      "color": "#6b7b83",
      "size": 11
    },
    "hpDie": {
      "font": "Merriweather24pt-Italic",
      "color": "#6b7b83",
      "alignment": "center",
      "size": 11
    },
    "marbleValue": {
      "font": "Merriweather24pt-Bold",
      "alignment": "center",
      "size": 14
    },
    "rollBoxText": {
      "font": "Oswald-SemiBold",
      "color": "#267890",
      "alignment": "center",
      "case": "uppercase",
      "size": 10
    },
    "skillTitle": {
      "font": "Merriweather24pt-Bold",
      "color": "#242422",
      "size": 13
    },
    "resName": {
      "font": "Merriweather24pt-Regular",
      "size": 13
    },
    "resValue": {
      "font": "Merriweather24pt-Bold",
      "alignment": "center",
      "size": 13
    },
    "heading1": {
      "font": "CoveredByYourGrace",
      "color": "#ffffff",
      "bgColor": "#284858",
      "padding": [2, 8],
      "size": 25
    },
    "heading2": {
      "font": "Oswald-SemiBold",
      "color": "#284858",
      "bgColor": "#AACACD40",
      "padding": [2, 8],
      "case": "uppercase",
      "size": 16
    },
    "bandHeading": {
      "font": "Oswald-SemiBold",
      "color": "#284858",
      "case": "uppercase",
      "size": 16
    },
    "heading3": {
      "font": "Oswald-SemiBold",
      "color": "#284858",
      "case": "uppercase",
      "size": 16,
      "divider": true
    },
    "heading4": {
      "font": "Oswald-SemiBold",
      "color": "#284858",
      "case": "uppercase",
      "size": 14
    },
    "heading5": {
      "font": "Merriweather24pt-Italic",
      "color": "#6b7b83",
      "size": 13
    },
    "heading6": {
      "font": "CoveredByYourGrace",
      "color": "#284858",
      "size": 22
    }
  }
}
