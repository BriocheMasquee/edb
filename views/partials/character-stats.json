{
  "spacing": 10,
  "padding": [16],
  "views": [
    {
      "type": "hStack",
      "bgColor": "#AACACD40",
      "padding": [2, 8],
      "views": [
        {
          "style": "bandHeading",
          "width": -1,
          "value": "{{'Character.Resistances'|l}}"
        }
      ]
    },
    {
      "type": "hStack",
      "spacing": 4,
      "alignment": "center",
      "views": [
        {
          "type": "spacer"
        },
        {
          "type": "hStack",
          "width": 150,
          "height": 20,
          "alignment": "center",
          "borderWidth": 1,
          "borderColor": "#267890",
          "cornerRadius": 4,
          "views": [
            {
              "type": "menuButton",
              "style": "wearButton",
              "alignment": "center",
              "width": -1,
              "height": 20,
              "value": "{% if data.rollMode == 'advantage' %}{{'Character.RollModeAdvantage'|l}}{% else %}{% if data.rollMode == 'disadvantage' %}{{'Character.RollModeDisadvantage'|l}}{% else %}{{'Character.RollModeNormal'|l}}{% endif %}{% endif %}",
              "views": [
                {
                  "type": "button",
                  "title": "Character.RollModeNormal",
                  "action": {
                    "set": {
                      "data.rollMode": "normal"
                    }
                  }
                },
                {
                  "type": "button",
                  "title": "Character.RollModeAdvantage",
                  "action": {
                    "set": {
                      "data.rollMode": "advantage"
                    }
                  }
                },
                {
                  "type": "button",
                  "title": "Character.RollModeDisadvantage",
                  "action": {
                    "set": {
                      "data.rollMode": "disadvantage"
                    }
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "vStack",
      "spacing": 8,
      "views": [
        {
          "type": "hStack",
          "spacing": 4,
          "alignment": "center",
          "visibleIf": "{% if data.resistances.grab != nil %}true{% endif %}",
          "views": [
            {
              "type": "hStack",
              "spacing": 4,
              "width": 212,
              "views": [
                {
                  "type": "text",
                  "style": "bullet",
                  "width": 14,
                  "value": "▪"
                },
                {
                  "style": "resName",
                  "value": "{{'Resistance.Grab'|l}}"
                }
              ]
            },
            {
              "style": "resValue",
              "width": 40,
              "value": "{{data.resistances.grab}}"
            },
            {
              "type": "spacer"
            },
            {
              "type": "button",
              "style": "rollButton",
              "alignment": "center",
              "width": 42,
              "height": 20,
              "title": "Character.RollTest",
              "link": "{% if data.rollMode == 'advantage' %}{% if data.advantageRule == 'd4' %}/roll/({{data.resistances.grab}}+24-d20+d4)÷24/{{'Resistance.Grab'|l}} ({{'Common.Advantage'|l}} d4)/check{% else %}/roll/((2d20cs<={{data.resistances.grab}})+1)÷2/{{'Resistance.Grab'|l}} ({{'Common.Advantage'|l}})/check{% endif %}{% else %}{% if data.rollMode == 'disadvantage' %}{% if data.advantageRule == 'd4' %}/roll/({{data.resistances.grab}}+24-d20-d4)÷24/{{'Resistance.Grab'|l}} ({{'Common.Disadvantage'|l}} d4)/check{% else %}/roll/(2d20cs<={{data.resistances.grab}})÷2/{{'Resistance.Grab'|l}} ({{'Common.Disadvantage'|l}})/check{% endif %}{% else %}/roll/1d20cs<={{data.resistances.grab}}/{{'Resistance.Grab'|l}}/check{% endif %}{% endif %}"
            }
          ]
        },
        {
          "type": "hStack",
          "spacing": 4,
          "visibleIf": "{% if data.resistances.grab == nil %}true{% endif %}",
          "views": [
            {
              "type": "text",
              "style": "bullet",
              "width": 14,
              "value": "▪"
            },
            {
              "style": "resName",
              "value": "{{'Resistance.Grab'|l}}"
            }
          ]
        },
