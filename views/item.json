{
  "spacing": 10,
  "padding": [16],
  "views": [
    {
      "type": "vStack",
      "spacing": 4,
      "views": [
        {
          "type": "hStack",
          "bgColor": "#284858",
          "padding": [2, 6],
          "views": [
            {
              "style": "bandTitle",
              "width": -1,
              "value": "{{name}}"
            }
          ]
        },
        {
          "style": "heading4",
          "value": "{{data.type | map: 'ItemType'}}"
        }
      ]
    },
    {
      "type": "vStack",
      "spacing": 16,
      "views": [
        {
          "type": "hStack",
          "spacing": 12,
          "alignment": "top",
          "bgColor": "#AACACD40",
          "padding": [8, 10],
          "visibleIf": "{% if data.price != nil and data.type != 'treasure' %}true{% elif data.encumbrance != nil %}true{% elif data.damage %}true{% elif data.protection != nil %}true{% elif data.usageDie and data.type != 'treasure' %}true{% endif %}",
          "views": [
            {
              "type": "vStack",
              "spacing": 2,
              "width": -1,
              "views": [
                {
                  "type": "text",
                  "style": "stats",
                  "value": "{% if data.price != nil and data.type != 'treasure' %}**{{'Item.Price'|l}}{{'Common.Colon'|l}}** {{data.price}}{% endif %}"
                },
                {
                  "type": "text",
                  "style": "stats",
                  "value": "{% if data.encumbrance != nil %}**{{'Item.Encumbrance'|l}}{{'Common.Colon'|l}}** {{data.encumbrance}}{% endif %}"
                }
              ]
            },
            {
              "type": "vStack",
              "spacing": 2,
              "width": -1,
              "views": [
                {
                  "type": "text",
                  "style": "stats",
                  "value": "{% if data.damage %}**{{'Common.Damages'|l}}{{'Common.Colon'|l}}** {{data.damage}}{% endif %}"
                },
                {
                  "type": "text",
                  "style": "stats",
                  "value": "{% if data.protection != nil %}**{{'Common.Protection'|l}}{{'Common.Colon'|l}}** {{data.protection}}{% endif %}"
                },
                {
                  "type": "text",
                  "style": "stats",
                  "value": "{% if data.usageDie and data.type != 'treasure' %}**{{'Common.UsageDie'|l}}{{'Common.Colon'|l}}** {{data.usageDie | map: 'DieType'}}{% endif %}"
                }
              ]
            }
          ]
        },
        {
          "type": "text",
          "value": "{{descr}}"
        }
      ]
    },
    {
      "type": "image",
      "value": "{{image}}",
      "link": "{{image}}"
    },
    {
      "type": "divider",
      "style": "rectangle",
      "height": 2,
      "padding": [0]
    },
    {
      "type": "text",
      "style": "source",
      "value": "{{sourceFormatted}}"
    }
  ]
}
