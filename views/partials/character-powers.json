{
  "spacing": 10,
  "padding": [16],
  "views": [
    {
      "type": "hStack",
      "spacing": 4,
      "alignment": "center",
      "bgColor": "#AACACD40",
      "padding": [2, 8, 2, 0],
      "views": [
        {
          "style": "bandHeading",
          "value": "{{'Entity.Power.many'|l}}"
        },
        {
          "type": "spacer"
        },
        {
          "style": "columnLabel",
          "width": 50,
          "value": "{{'Power.Prepared'|l}}"
        },
        {
          "style": "columnLabel",
          "width": 80,
          "value": "{{'Power.Used'|l}}"
        }
      ]
    },
    {
      "type": "list",
      "attribute": "data.powers",
      "views": [
        {
          "type": "hStack",
          "spacing": 4,
          "alignment": "top",
          "views": [
            {
              "type": "vStack",
              "alignment": "leading",
              "width": -1,
              "views": [
                {
                  "type": "disclosureGroup",
                  "title": "{{name}}",
                  "style": "skillTitle",
                  "views": [
                    {
                      "type": "text",
                      "value": "{{descr}}"
                    }
                  ]
                }
              ]
            },
            {
              "type": "hStack",
              "width": 50,
              "visibleIf": "{% if type == 'tale' %}true{% endif %}",
              "views": [
                {
                  "type": "spacer"
                },
                {
                  "type": "checkbox",
                  "attribute": "prepared"
                },
                {
                  "type": "spacer"
                }
              ]
            },
            {
              "style": "columnLabel",
              "width": 50,
              "value": "–",
              "visibleIf": "{% if type != 'tale' %}true{% endif %}"
            },
            {
              "type": "hStack",
              "width": 80,
              "views": [
                {
                  "type": "spacer"
                },
                {
                  "type": "checkbox",
                  "attribute": "used"
                },
                {
                  "type": "spacer"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "divider",
      "style": "rectangle",
      "height": 2,
      "padding": [0]
    }
  ]
}
